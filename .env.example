# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# IA: captura de pedidos y análisis semanal.
# Orden de motores: Claude (si hay ANTHROPIC_API_KEY) → Gemini (si hay GEMINI_API_KEY) → lector local sin IA.
# Si un motor falla, tarda de más o responde algo inválido, se usa el siguiente.
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Opcionales. Si se omiten se usan estos valores por defecto.
ANTHROPIC_MODEL="claude-opus-5-5"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Tiempo máximo por llamada a la IA, en milisegundos.
AI_TIMEOUT_MS="20000"

# External Integrations & Webhooks (Costa Rica PyMEs & Distribuidoras)
ERP_INVENTORY_WEBHOOK_URL="https://api.erp-ejemplo.cr/webhooks/inventario"
INVOICING_API_URL="https://api.facturacion-electronica.cr/v4/comprobantes"
EXTERNAL_COURIER_API_URL="https://api.courier-cr.example/v1/envios"

# App URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
