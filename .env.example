# Copia este archivo como .env.local y completa solo lo que vayas a usar.
# Todas las variables son opcionales: sin ninguna, la app corre en modo demostración
# con datos locales y el lector de pedidos sin IA.
# .env.local está en .gitignore. Nunca subas llaves reales al repositorio.

# --- IA: captura de pedidos (texto, foto, PDF, audio) y análisis semanal de gerencia ---
# Orden de motores: Claude (si hay ANTHROPIC_API_KEY) → Gemini (si hay GEMINI_API_KEY) → lector local sin IA.
# Si un motor falla, tarda de más o responde algo inválido, se usa el siguiente.
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Modelos. Si se omiten se usan estos valores.
ANTHROPIC_MODEL="claude-opus-5-5"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Tiempo máximo por llamada a la IA, en milisegundos.
AI_TIMEOUT_MS="20000"

# --- Supabase (solo para desplegar; la demo local no lo necesita) ---
# Sin estos valores los datos se guardan en .data/innova-track-store.json.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Llave de servicio: solo se usa en el servidor. Trátala como una contraseña.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Integraciones externas ---
# Con estos valores de ejemplo, inventario, factura electrónica y courier funcionan en modo demostración.
# Al poner una URL real, la app envía ahí cada reserva, factura o despacho.
ERP_INVENTORY_WEBHOOK_URL="https://api.erp-ejemplo.cr/webhooks/inventario"
INVOICING_API_URL="https://api.facturacion-electronica.cr/v4/comprobantes"
EXTERNAL_COURIER_API_URL="https://api.courier-cr.example/v1/envios"

# --- Servidor de desarrollo ---
# Puerto de `npm run dev` (por defecto 3000).
# PORT="3000"
